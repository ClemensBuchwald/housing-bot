# Housing Bot — Umgebungsvariablen (Vorlage)
# Kopiere diese Datei nach .env und befülle alle Werte.
# .env wird NICHT ins Git committet.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- E-Mail (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=

# --- Portale ---
# ImmobilienScout24
IS24_API_KEY=

# ImmoWelt (falls API verfügbar)
IMMOWELT_USER=
IMMOWELT_PASSWORD=

# WG-Gesucht
WG_GESUCHT_USER=
WG_GESUCHT_PASSWORD=

# eBay Kleinanzeigen
EBAY_KA_USER=
EBAY_KA_PASSWORD=

# --- Datenbank ---
# SQLite (Standard) oder Postgres
DATABASE_URL=sqlite:///data/housing_bot.db

# --- Scraping ---
# Pause zwischen Requests (Sekunden, Zufallsbereich)
SCRAPE_DELAY_MIN=5
SCRAPE_DELAY_MAX=15

# Intervall zwischen kompletten Durchläufen (Minuten)
POLL_INTERVAL=10

# --- Logging ---
LOG_LEVEL=INFO
